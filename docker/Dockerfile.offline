FROM python:3.9-slim

WORKDIR /app

ENV NLTK_DATA=/usr/share/nltk_data \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .

# Install deps + spaCy model (needs internet ONCE at build time)
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download en_core_web_sm \
    && python -c "import spacy; spacy.load('en_core_web_sm'); print('spaCy model OK')"

# Download NLTK data inside the image (host nltk_data/ is NOT required)
RUN mkdir -p /usr/share/nltk_data \
    && python -c "import nltk; \
nltk.download('punkt', download_dir='/usr/share/nltk_data'); \
nltk.download('punkt_tab', download_dir='/usr/share/nltk_data'); \
nltk.download('wordnet', download_dir='/usr/share/nltk_data'); \
nltk.download('omw-1.4', download_dir='/usr/share/nltk_data'); \
nltk.download('cmudict', download_dir='/usr/share/nltk_data'); \
print('NLTK data OK')" \
    && cd /usr/share/nltk_data/corpora \
    && if [ -f wordnet.zip ] && [ ! -d wordnet ]; then \
         python -c "import zipfile; zipfile.ZipFile('wordnet.zip').extractall('.')"; \
       fi

# Image copy = fallback. Runtime mounts src/ and Book1.xlsx from host.
COPY src/ ./src/
COPY Book1.xlsx ./

RUN mkdir -p /app/data/input /app/data/output

ENTRYPOINT ["python", "-m", "src.main"]
