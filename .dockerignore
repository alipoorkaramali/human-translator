# =============================================================================
# .dockerignore — حذف فایلهای غیرضروری از build context
# =============================================================================

# ---------- Git ----------
.git
.gitignore
.gitattributes
.github

# ---------- Python virtualenvs ----------
.venv
venv
env
ENV

# ---------- Python cache ----------
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- Test / Lint cache ----------
.pytest_cache/
.mypy_cache/
.flake8_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ---------- pip ----------
pip-wheel-metadata/

# ---------- NLTK data ----------
nltk_data/

# ---------- Project data ----------
data/output/
data/input/
*.xlsx
!Book1.xlsx

# ---------- IDE / Editor ----------
.vscode/
.idea/
.editorconfig
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Logs & temp ----------
*.log
logs/
tmp/
temp/
*.bak
*.tmp
*.orig
*.rej

# ---------- Env / secrets ----------
.env
.env.*
*.pem
*.key

# ---------- Tests (در runtime لازم نیست) ----------
tests/

# ---------- مستندات و تنظیمات پروژه ----------
README.md
LICENSE
CHANGELOG.md
docs/
setup.py
setup.cfg
pyproject.toml
Makefile

# ⚠️ توجه: اینها را ignore نکن:
#   - scripts/         (Dockerfile از آن استفاده میکند)
#   - docker/          (خود Dockerfile اینجاست)
#   - requirements.txt (Dockerfile COPY میکند)
#   - Book1.xlsx       (Dockerfile COPY میکند، با !Book1.xlsx استثنا شده)
#   - src/             (کد اصلی)
